{
  "name": "lumadesk",
  "version": "1.0.0",
  "description": "Markdown preview and Word export desktop app",
  "author": "Peerluma",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysrgozudeli/lumadesk.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "com.peerluma.lumadesk",
    "productName": "LumaDesk",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ysrgozudeli",
        "repo": "lumadesk"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "lib/**",
      "node_modules/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "LumaDesk-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "LumaDesk ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "maintainer": "Peerluma <ysrgozudeli@gmail.com>",
      "synopsis": "Markdown preview and Word/PDF export desktop app"
    }
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "docx": "^9.4.1",
    "marked": "^17.0.1",
    "mermaid": "^11.14.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1"
  }
}
